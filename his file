    self.comments_text = tk.Text(left_frame, height=4, font=("Segoe UI", 10))
    self.comments_text.pack(fill="x", pady=(3, 12))

    # File Picker Widget
    ttk.Label(left_frame, text="Attach file:").pack(anchor="w")
    file_frame = ttk.Frame(left_frame)
    file_frame.pack(fill="x", pady=(3, 16))
    
