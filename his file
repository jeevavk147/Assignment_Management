# --- Helper Logic ---
def browse_file(self):
    filename = filedialog.askopenfilename(
        title="Select Assignment File",
        filetypes=[
            ("Documents & Archives", "*.pdf *.doc *.docx *.txt *.zip *.py"),
            ("All Files", "*.*"),
        ],
    )
    if filename:
        self.selected_file_path = filename
        self.file_label.config(text=os.path.basename(filename), foreground="black")

def submit_assignment(self):
    title = self.assignment_title_entry.get().strip()
    if not title:
        messagebox.showwarning("Missing Information", "Please enter an assignment title.")
        return
    if not self.selected_file_path or not os.path.isfile(self.selected_file_path):
        messagebox.showwarning("Missing File", "Please browse and select a file before submitting.")
        return

    course = self.course_var.get()
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    original_name = os.path.basename(self.selected_file_path)
    saved_name = f"{timestamp}_{original_name}"
    saved_path = os.path.join(self.submissions_folder, saved_name)

    try:
        # Save a copy of the attached file to local submission directory
        shutil.copy2(self.selected_file_path, saved_path)
        
        # Log record to CSV
        submitted = datetime.now().strftime("%d %b %Y %I:%M %p")
        with open(self.log_file, "a", newline="", encoding="utf-8") as log:
            csv.writer(log).writerow([self.logged_in_user, course, title, saved_name, submitted])
    except OSError as error:
        messagebox.showerror("Submission Failed", f"The file could not be saved:\\n{error}")
        return

    # Update Treeview and reset fields
    self.history_tree.insert("", 0, values=(course.split(" - ")[0], title, saved_name, submitted))
    messagebox.showinfo("Success", "Your assignment has been submitted successfully!")
    
    self.assignment_title_entry.delete(0, tk.END)
    self.comments_text.delete("1.0", tk.END)
    self.selected_file_path = ""
    self.file_label.config(text="No file selected", foreground="gray")

def load_submission_history(self):
    try:
        with open(self.log_file, "r", newline="", encoding="utf-8") as log:
            rows = list(csv.reader(log))[1:]
    except OSError:
        return
        
    for row in reversed(rows):
        if len(row) == 5:
            # Displays course code, assignment title, file name, and timestamp
            self.history_tree.insert("", "end", values=(row[1].split(" - ")[0], row[2], row[3], row[4]))