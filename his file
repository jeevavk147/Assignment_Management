    self.logged_in_user = ""
    self.selected_file_path = ""
    
    # Local storage setup for saving submitted files and logs
    self.submissions_folder = os.path.join(os.getcwd(), "Student_Submissions")
    self.log_file = os.path.join(self.submissions_folder, "submissions.csv")

    self.configure_styles()
    self.setup_storage()

    self.container = ttk.Frame(self)
    self.container.pack(fill="both", expand=True)
    self.show_login_screen()

def configure_styles(self):
    style = ttk.Style(self)
    style.theme_use("clam")
    style.configure(".", background="#f4f6f7", font=("Segoe UI", 10))
    style.configure("TFrame", background="#f4f6f7")
    style.configure("Header.TLabel", font=("Segoe UI", 18, "bold"), foreground="#2c3e50")
    style.configure("SubHeader.TLabel", font=("Segoe UI", 12, "bold"), foreground="#2c3e50")
    style.configure("Accent.TButton", font=("Segoe UI", 10, "bold"), foreground="white", background="#3498db")
    style.map("Accent.TButton", background=[("active", "#2980b9")])
    style.configure("Treeview", rowheight=27)

def setup_storage(self):
    os.makedirs(self.submissions_folder, exist_ok=True)
    if not os.path.exists(self.log_file):
        with open(self.log_file, "w", newline="", encoding="utf-8") as log:
            csv.writer(log).writerow(["Student", "Course", "Assignment", "File", "Submitted"])

def clear_screen(self):
    for widget in self.container.winfo_children():
        widget.destroy()

# --- Login View ---
def show_login_screen(self):
    self.clear_screen()
    login_frame = ttk.Frame(self.container, padding=40)
    login_frame.place(relx=0.5, rely=0.5, anchor="center")

    ttk.Label(login_frame, text="Student Portal Login", style="Header.TLabel").grid(
        row=0, column=0, columnspan=2, pady=(0, 20)
    )
    ttk.Label(login_frame, text="Username / Student ID:").grid(row=1, column=0, sticky="w", pady=6)
    self.username_entry = ttk.Entry(login_frame, width=32)
    self.username_entry.grid(row=1, column=1, padx=(12, 0), pady=6)

    ttk.Label(login_frame, text="Password:").grid(row=2, column=0, sticky="w", pady=6)
    self.password_entry = ttk.Entry(login_frame, width=32, show="*")
    self.password_entry.grid(row=2, column=1, padx=(12, 0), pady=6)

    ttk.Button(login_frame, text="Login", style="Accent.TButton", command=self.handle_login).grid(
        row=3, column=0, columnspan=2, sticky="ew", pady=(20, 0)
    )
    ttk.Label(login_frame, text="Enter any credentials to log in.", foreground="gray").grid(
        row=4, column=0, columnspan=2, pady=(12, 0)
    )
    self.username_entry.focus_set()

def handle_login(self):
    username = self.username_entry.get().strip()
    password = self.password_entry.get().strip()
    if not username or not password:
        messagebox.showwarning("Login failed", "Please enter both a username and password.")
        return

    self.logged_in_user = username
    self.show_dashboard_screen()

# --- Main Dashboard View ---
def show_dashboard_screen(self):
    self.clear_screen()
    
    # Header bar
    header = ttk.Frame(self.container, padding=(20, 12))
    header.pack(fill="x")
    ttk.Label(header, text="Welcome, " + self.logged_in_user, style="Header.TLabel").pack(side="left")
    ttk.Button(header, text="Logout", command=self.show_login_screen).pack(side="right")

    # Tabs Navigation
    notebook = ttk.Notebook(self.container)
    notebook.pack(fill="both", expand=True, padx=20, pady=(0, 20))
    
    assignments_tab = ttk.Frame(notebook, padding=20)
    courses_tab = ttk.Frame(notebook, padding=20)
    
    notebook.add(assignments_tab, text=" Submit Assignments ")
    notebook.add(courses_tab, text=" Course Overview ")

    self.build_assignments_tab(assignments_tab)
    self.build_courses_tab(courses_tab)

